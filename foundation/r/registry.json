{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "foundation",
  "homepage": "https://github.com/cowboyshibuya/jutsu/tree/main/foundation",
  "items": [
    {
      "name": "tokens",
      "type": "registry:style",
      "title": "Design tokens",
      "description": "Primitives, semantic tokens (light and dark), Tailwind v4 names and the shadcn bridge.",
      "files": [
        {
          "path": "tokens/primitives.css",
          "type": "registry:file",
          "target": "styles/foundation/primitives.css"
        },
        {
          "path": "tokens/semantic.css",
          "type": "registry:file",
          "target": "styles/foundation/semantic.css"
        },
        {
          "path": "tokens/shadcn.css",
          "type": "registry:file",
          "target": "styles/foundation/shadcn.css"
        },
        {
          "path": "tokens/tailwind.css",
          "type": "registry:file",
          "target": "styles/foundation/tailwind.css"
        }
      ]
    },
    {
      "name": "check-tokens",
      "type": "registry:file",
      "title": "Token check",
      "description": "Fails on raw colours, raw sizes, palette classes and primitives used in components; lists @decide values.",
      "files": [
        {
          "path": "checks/check-tokens.mjs",
          "type": "registry:file",
          "target": "~/scripts/check-tokens.mjs"
        }
      ]
    },
    {
      "name": "page-header",
      "type": "registry:block",
      "title": "Page header",
      "description": "The page's fact as its title, the page name as eyebrow, one action that collapses to an icon.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "utils",
        "{{base}}/tokens.json"
      ],
      "files": [
        {
          "path": "blocks/page-header.tsx",
          "type": "registry:block",
          "target": "components/blocks/page-header.tsx"
        },
        {
          "path": "blocks/page-header.md",
          "type": "registry:file",
          "target": "components/blocks/page-header.md"
        }
      ]
    },
    {
      "name": "metric",
      "type": "registry:block",
      "title": "Metric",
      "description": "A metric tile and grid: short label, icon on wide screens, arrow-only delta on phones.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "utils",
        "{{base}}/tokens.json"
      ],
      "files": [
        {
          "path": "blocks/metric.tsx",
          "type": "registry:block",
          "target": "components/blocks/metric.tsx"
        },
        {
          "path": "blocks/metric.md",
          "type": "registry:file",
          "target": "components/blocks/metric.md"
        }
      ]
    },
    {
      "name": "empty-state",
      "type": "registry:block",
      "title": "Empty state",
      "description": "An icon, a title saying what will appear, and the next valid action.",
      "dependencies": [
        "lucide-react"
      ],
      "registryDependencies": [
        "utils",
        "{{base}}/tokens.json"
      ],
      "files": [
        {
          "path": "blocks/empty-state.tsx",
          "type": "registry:block",
          "target": "components/blocks/empty-state.tsx"
        },
        {
          "path": "blocks/empty-state.md",
          "type": "registry:file",
          "target": "components/blocks/empty-state.md"
        }
      ]
    }
  ]
}
